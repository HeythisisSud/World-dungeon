# ==============================================================================
# WORLD DUNGEON BACKEND — CONFIGURATION
# ==============================================================================

# Ollama LLM Service URL and Model
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# Service Port
PORT=3001

# Optional: SerpApi Search Enrichment (100 free searches/mo)
# https://serpapi.com
SERPAPI_KEY=your_serpapi_key_here

# Frontend Application Origin(s) for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-domain.vercel.app
