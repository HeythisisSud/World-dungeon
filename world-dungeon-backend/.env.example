# ==============================================================================
# WORLD DUNGEON BACKEND — CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INFERENCE CONFIGURATION (Groq Cloud vs Local Ollama)
# ------------------------------------------------------------------------------
# Production Mode: Groq Cloud API (Free tier, ultra-fast Gemma2-9b-it inference)
# Get a free API key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=gemma2-9b-it

# Set to true to force local Ollama offline mode instead of Groq
USE_LOCAL_OLLAMA=false

# Local Offline Mode: Ollama Server URL and Model (used when USE_LOCAL_OLLAMA=true)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# ------------------------------------------------------------------------------
# 2. SERVER & SECURITY
# ------------------------------------------------------------------------------
PORT=3001

# Optional: SerpApi Search Enrichment (100 free searches/mo)
# https://serpapi.com
SERPAPI_KEY=

# Frontend Application Origin(s) for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-domain.vercel.app
