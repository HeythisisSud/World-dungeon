# ==============================================================================
# WORLD DUNGEON — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend Service URL (Fastify Quest Forge Service on port 3001)
BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Mapillary Open Street-Level Imagery API Token
# Get free token: https://www.mapillary.com/dashboard/developers
NEXT_PUBLIC_MAPILLARY_TOKEN=MLY|YOUR_MAPILLARY_CLIENT_TOKEN_HERE

# ElevenLabs Ancient Voice Narration API Key
# Get key: https://elevenlabs.io (Free tier supported with models: eleven_turbo_v2_5)
NEXT_PUBLIC_ELEVENLABS_KEY=sk_YOUR_ELEVENLABS_API_KEY_HERE
ELEVENLABS_KEY=sk_YOUR_ELEVENLABS_API_KEY_HERE
